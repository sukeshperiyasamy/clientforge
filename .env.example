# Local owner application. Never commit .env or put credentials in prompts.
PORT=3000
DATA_DIR=data
AGY_PATH=agy
# Local Postiz uses /api/public/v1. Hosted Postiz uses https://api.postiz.com/public/v1
POSTIZ_URL=http://localhost:4007/api/public/v1
POSTIZ_API_KEY=
# Enable only after connecting your account and reviewing a real test post.
PUBLISHING_ENABLED=false
# Separate portfolio process; these do not expose the private dashboard.
PUBLIC_PORT=3001
PUBLIC_BIND=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3001
# Leave unset locally. Set only behind a known reverse proxy after deployment review.
PUBLIC_TRUST_PROXY=
# Optional read-only identity integrations. Register exact callback URLs first.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub callback: http://localhost:3000/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# YouTube callback: http://localhost:3000/auth/youtube/callback
